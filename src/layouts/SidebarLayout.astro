---
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import Footer from "@/components/Footer.astro";
import Navbar from "@/components/Navbar.astro";
import { getModules } from "@/data/lessons";
import ArticleIcon from "@/icons/ArticleIcon.astro";
import CirclePlayIcon from "@/icons/CirclePlayIcon.astro";
import CloseIcon from "@/icons/CloseIcon.astro";
import SidebarIcon from "@/icons/SidebarIcon.astro";
import { type BreadcrumbItem, focusRing, samePath } from "@/lib/navigation";
import BaseLayout from "./BaseLayout.astro";

interface Props {
	title?: string;
	description?: string;
	breadcrumbItems?: BreadcrumbItem[];
	canonical?: string;
	noindex?: boolean;
	ogType?: "website" | "article" | "profile";
	image?: string;
}

const { title, description, breadcrumbItems = [], canonical, noindex, ogType, image } = Astro.props;
const modules = getModules();
const pathname = Astro.url.pathname;
const isActive = (href: string) => samePath(pathname, href);

const itemClass = (active: boolean) =>
	active
		? "bg-gray-950/5 font-semibold text-gray-950 dark:bg-white/5 dark:text-white"
		: "text-gray-700 hover:bg-gray-950/4 dark:text-gray-400 dark:hover:bg-white/5";
const iconClass = (active: boolean) =>
	active ? "text-gray-950 dark:text-white" : "text-gray-400 dark:text-gray-500";
---

<BaseLayout title={title} description={description} canonical={canonical} noindex={noindex} ogType={ogType} image={image}>
	<slot name="head" slot="head" />
	<Navbar activeHref="/" />
	<div class="flex min-h-[calc(100dvh-4rem)]">
		<!-- Desktop Sidebar -->
		<aside class="hidden w-72 shrink-0 border-r border-gray-950/10 dark:border-white/10 lg:block">
			<nav aria-label="Kursusindhold" class="sticky top-16 h-[calc(100dvh-4rem)] space-y-6 overflow-y-auto px-4 py-6">
				{modules.map((module, moduleIndex) => (
					<div>
						<h3 class="px-2 text-xs/6 font-semibold text-gray-600 dark:text-gray-400">
							Del {moduleIndex + 1} &mdash; {module.title}
						</h3>
						<ul class="mt-1 space-y-0.5">
							{module.lessons.map((lesson) => {
								const href = `/${lesson.id}`;
								const active = isActive(href);
								const Icon = lesson.video ? CirclePlayIcon : ArticleIcon;
								return (
									<li>
										<a
											href={href}
											aria-current={active ? "page" : undefined}
											class:list={["-mx-1 flex items-center gap-2 rounded-lg px-3 py-1 text-sm/7", itemClass(active)]}
										>
											<Icon class={iconClass(active)} />
											<span class="truncate">{lesson.title}</span>
										</a>
									</li>
								);
							})}
						</ul>
					</div>
				))}
			</nav>
		</aside>

		<!-- Mobile Sidebar Drawer -->
		<dialog
			id="mobile-sidebar"
			aria-labelledby="mobile-sidebar-title"
			class="h-dvh max-h-none w-full max-w-xs bg-white text-gray-950 ring ring-gray-950/10 backdrop:bg-gray-950/25 lg:hidden dark:bg-gray-950 dark:text-white dark:ring-white/10"
			data-drawer
		>
			<div class="h-full overflow-y-auto overscroll-contain px-4 py-3">
				<div class="flex h-10 items-center justify-between pl-2">
					<h2 id="mobile-sidebar-title" class="text-base/7 font-semibold">Kursusindhold</h2>
					<button
						type="button"
						class:list={["-mr-2.5 inline-flex size-11 cursor-pointer items-center justify-center rounded-md hover:bg-gray-950/5 dark:hover:bg-white/5", focusRing]}
						data-close-dialog
						aria-label="Luk kursusindhold"
					>
						<CloseIcon />
					</button>
				</div>
				<nav aria-label="Kursusindhold" class="mt-4 space-y-6">
					{modules.map((module, moduleIndex) => (
						<div>
							<h3 class="px-2 text-xs/6 font-semibold text-gray-600 dark:text-gray-400">
								Del {moduleIndex + 1} &mdash; {module.title}
							</h3>
							<ul class="mt-1 space-y-0.5">
								{module.lessons.map((lesson) => {
									const href = `/${lesson.id}`;
									const active = isActive(href);
									const Icon = lesson.video ? CirclePlayIcon : ArticleIcon;
									return (
										<li>
											<a
												href={href}
												aria-current={active ? "page" : undefined}
												class:list={["flex min-h-11 items-center gap-2 rounded-lg px-3 py-1 text-sm/7", itemClass(active)]}
											>
												<Icon class={iconClass(active)} />
												<span class="truncate">{lesson.title}</span>
											</a>
										</li>
									);
								})}
							</ul>
						</div>
					))}
				</nav>
			</div>
		</dialog>

		<!-- Main Content -->
		<div class="flex min-w-0 flex-1 flex-col">
			<main class="flex-1 px-4 pb-16 sm:px-6">
				<div class="flex items-center gap-x-3 py-3">
					<button
						type="button"
						class:list={["inline-flex min-h-11 shrink-0 cursor-pointer items-center gap-x-2 rounded-md border border-gray-950/10 px-3 text-sm/6 font-medium text-gray-950 hover:bg-gray-950/5 lg:hidden dark:border-white/10 dark:text-white dark:hover:bg-white/5", focusRing]}
						data-open-dialog="mobile-sidebar"
						aria-haspopup="dialog"
						aria-controls="mobile-sidebar"
					>
						<SidebarIcon />
						Kursusindhold
					</button>
					{breadcrumbItems.length > 0 && <Breadcrumbs items={breadcrumbItems} hideRootOnMobile />}
				</div>
				<slot />
			</main>
			<Footer />
		</div>
	</div>
</BaseLayout>
