---
import { getImage } from "astro:assets";
import type { RelatedLink } from "@/data/articles";
import { banners as rawBanners } from "@/data/banners";

interface Props {
	empty?: boolean;
	emptyMessage?: string;
	relatedLinks?: RelatedLink[];
}

const {
	empty = false,
	emptyMessage = "Denne artikel er under udarbejdelse.",
	relatedLinks = [],
} = Astro.props;

const banners = await Promise.all(
	rawBanners.map(async ({ image, ...rest }) => {
		const { src, attributes } = await getImage({ src: image, format: "webp" });
		return { src, width: attributes.width as number, height: attributes.height as number, ...rest };
	}),
);

// The wrapper sets the reading width once so the byline and #content share both edges.
// Long Danish compounds in headings wrap (hyphenated, as <html lang="da">) instead of
// widening the page on small screens; table headers are left out of the hyphenation.
const proseClass = [
	"prose prose-base max-w-none dark:prose-invert",
	"prose-headings:wrap-break-word prose-h1:text-3xl sm:prose-h1:text-4xl",
	"prose-h1:hyphens-auto prose-h2:hyphens-auto prose-h3:hyphens-auto prose-h4:hyphens-auto",
	"prose-a:text-brand-700 prose-a:hover:text-brand-800 dark:prose-a:text-brand-400 dark:prose-a:hover:text-brand-300",
].join(" ");
---

<div class="max-w-prose text-base">
	<slot name="byline" />
	{empty ? (
		<div id="content" class={proseClass}>
			<div class="flex flex-col items-center justify-center py-20 text-center">
				<p class="text-lg font-medium text-gray-950 dark:text-white">Kommer snart</p>
				<p class="mt-2 text-sm text-gray-600 dark:text-gray-400">{emptyMessage}</p>
			</div>
		</div>
	) : (
		<div>
			<div id="content" class={proseClass} data-banners={JSON.stringify(banners)}>
				<slot />
				{relatedLinks.length > 0 && (
					<aside data-contextual-links class="not-prose my-10 rounded-xl border border-gray-950/10 bg-gray-950/[0.025] p-5 dark:border-white/10 dark:bg-white/[0.025]" aria-label="Relaterede guides">
						<p class="text-sm font-semibold text-gray-950 dark:text-white">Læs også</p>
						<ul class="mt-3 space-y-2">
							{relatedLinks.slice(0, 3).map((link) => (
								<li>
									<a href={link.href} class="text-sm/6 font-medium text-gray-800 underline decoration-gray-950/20 underline-offset-2 hover:decoration-gray-950 dark:text-gray-200 dark:decoration-white/20 dark:hover:decoration-white">
										{link.title}
									</a>
									<span class="text-sm/6 text-gray-600 dark:text-gray-400"> — {link.description}</span>
								</li>
							))}
						</ul>
					</aside>
				)}
			</div>
		</div>
	)}
</div>

<script>
	import { type Banner, placeBanners, selectBanner } from "@/lib/banners";

	function isStringArray(value: unknown): value is string[] {
		return Array.isArray(value) && value.every((item) => typeof item === "string");
	}

	function isBanner(value: unknown): value is Banner {
		return (
			typeof value === "object" &&
			value !== null &&
			"src" in value &&
			typeof value.src === "string" &&
			"width" in value &&
			typeof value.width === "number" &&
			"height" in value &&
			typeof value.height === "number" &&
			"alt" in value &&
			typeof value.alt === "string" &&
			"href" in value &&
			typeof value.href === "string" &&
			"keywords" in value &&
			isStringArray(value.keywords) &&
			"exclude" in value &&
			isStringArray(value.exclude)
		);
	}

	// The banner data is only rendered on a populated #content.
	const content = document.getElementById("content");
	const payload = content?.dataset.banners;
	if (content && payload) {
		const parsed: unknown = JSON.parse(payload);
		const banners = Array.isArray(parsed) ? parsed.filter(isBanner) : [];
		const page = {
			title: document.title,
			contentText: content.textContent ?? "",
			h1Text: document.querySelector("h1")?.textContent ?? "",
		};
		// Repeat only the selected contextual partner banner.
		placeBanners(content, selectBanner(page, banners));
	}
</script>
