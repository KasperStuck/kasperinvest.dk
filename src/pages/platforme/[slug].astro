---
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import ArticleSchema from "@/components/ArticleSchema.astro";
import AuthorBox from "@/components/AuthorBox.astro";
import Disclaimer from "@/components/Disclaimer.astro";
import Prose from "@/components/Prose.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import { getPlatform, getPlatformContent, getPlatforms } from "@/data/platforms";
import { getRelatedLinks } from "@/data/related";
import ChevronRightIcon from "@/icons/ChevronRightIcon.astro";
import SectionLayout from "@/layouts/SectionLayout.astro";

export function getStaticPaths() {
	return getPlatforms().map((p) => ({
		params: { slug: p.id },
	}));
}

const { slug } = Astro.params;
if (!slug) return new Response(null, { status: 404, statusText: "Not Found" });
const platform = getPlatform(slug);

if (!platform) {
	return new Response(null, { status: 404, statusText: "Not Found" });
}

const sidebarItems = getPlatforms().map((p) => ({
	id: p.id,
	title: p.title,
	href: `/platforme/${p.id}`,
}));

let Content: AstroComponentFactory | null = null;
try {
	Content = (await getPlatformContent(slug)) as AstroComponentFactory;
} catch {
	// MDX file doesn't exist yet
}

const breadcrumbItems = [
	{ label: "KasperInvest", href: "/" },
	{ label: "Platforme", href: "/platforme", class: "max-md:hidden" },
	{ label: platform.title },
];
const relatedLinks = getRelatedLinks(Astro.url.pathname);
---

<SectionLayout
	title={`${platform.seoTitle ?? `${platform.title} - Platforme`} - KasperInvest`}
	description={platform.description}
	breadcrumbItems={breadcrumbItems}
	sectionTitle="Platforme"
	sidebarItems={sidebarItems}
	ogType="article"
>
	<ArticleSchema headline={platform.title} description={platform.description} />
	<div class="mx-auto max-w-7xl">
		<div class="mx-auto flex max-w-2xl gap-x-10 py-10 sm:py-14 lg:max-w-5xl">
			<div class="w-full flex-1">
				<AuthorBox />
				<Prose empty={!Content} relatedLinks={relatedLinks}>
					{Content && <Content />}
				</Prose>
				<div class="mt-16 border-t border-gray-200 pt-8 dark:border-white/10">
					{platform.next ? (
						<div class="flow-root">
							<a
								href={`/platforme/${platform.next.id}`}
								class="-mx-3 -my-2 block rounded-xl px-3 py-2 hover:bg-gray-950/4 dark:hover:bg-white/5"
							>
								<p class="flex items-center gap-3 text-sm/7 text-gray-600">
									Næste
									<ChevronRightIcon />
								</p>
								<p class="mt-3 text-base/7 font-medium text-gray-950 dark:text-white">
									{platform.next.title}
								</p>
								<p class="text-sm/7 text-gray-700 dark:text-gray-400">
									{platform.next.description}
								</p>
							</a>
						</div>
					) : (
						<div class="flow-root">
							<a
								href="/"
								class="-mx-3 -my-2 block rounded-xl px-3 py-2 hover:bg-gray-950/4 dark:hover:bg-white/5"
							>
								<p class="flex items-center gap-3 text-sm/7 text-gray-600">
									Tilbage
									<ChevronRightIcon />
								</p>
								<p class="mt-3 text-base/7 font-medium text-gray-950 dark:text-white">
									Kursusoversigt
								</p>
								<p class="text-sm/7 text-gray-700 dark:text-gray-400">
									Gå tilbage til investeringskurset.
								</p>
							</a>
						</div>
					)}
				</div>
				<Disclaimer />
			</div>
			<div class="hidden w-66 lg:block">
				<TableOfContents contentId="content" />
			</div>
		</div>
	</div>
</SectionLayout>
