{
	"name": "kasperinvest.dk",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "bun@1.4.2",
	"engines": {
		"node": ">=24.0.0 <25.0.0"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro check && astro build",
		"preview": "astro preview",
		"check": "astro check",
		"typecheck": "astro check",
		"lint": "biome check . && eslint convex",
		"lint:fix": "biome check --write . && eslint convex --fix",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"seo:gsc": "bun scripts/gsc-opportunities.ts",
		"content:sample": "bun scripts/content-sample.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:ui": "vitest --ui",
		"start": "bun ./dist/server/entry.mjs",
		"install:prod": "bun install --production --frozen-lockfile --ignore-scripts --minimum-release-age 86400",
		"lockfile:lint": "bun pm hash && ! grep -En \"(git\\+|github:|gitlab:|bitbucket:|ssh://|file:|http://)\" bun.lock",
		"deps:scan": "bun pm scan"
	},
	"dependencies": {
		"@ai-sdk/provider-utils": "^3.0.22",
		"@astrojs/node": "^11.1.6",
		"@convex-dev/action-retrier": "^0.3.0",
		"@convex-dev/agent": "^0.3.2",
		"@egoist/youtube-transcript-plus": "^1.1.2",
		"@sentry/astro": "10.75.0",
		"ai": "^5.0.154",
		"astro": "^7.3.3",
		"convex": "^1.32.0",
		"convex-helpers": "^0.1.114",
		"marked": "^17.0.4",
		"node-webvtt": "^1.9.4",
		"shiki": "^4.0.1",
		"slugify": "^1.6.6",
		"web-vitals": "^5.1.0",
		"zod": "^4.0.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@astrojs/mdx": "^8.0.1",
		"@biomejs/biome": "^2.4.6",
		"@convex-dev/eslint-plugin": "^2",
		"@shikijs/colorized-brackets": "^4.0.1",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3",
		"@vitest/ui": "^4.1",
		"convex-test": "0.0.54",
		"eslint": "^10",
		"happy-dom": "^20.8.3",
		"tailwindcss": "^4.2.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8",
		"vitest": "^4.1"
	},
	"trustedDependencies": [
		"esbuild",
		"sharp"
	]
}
