---
import OTPInput from "@/components/OTPInput.astro";
import AuthLayout from "@/layouts/AuthLayout.astro";
import { focusRing, primaryButton } from "@/lib/navigation";
---

<AuthLayout title="Indtast engangskode - KasperInvest">
	<h1 class="sr-only">Indtast engangskode</h1>
	<p class="text-center text-sm/7 text-gray-950 dark:text-white">
		Vi har sendt en 6-cifret bekræftelseskode til{" "}
		<span class="font-semibold">adam@example.com</span>.
	</p>
	<form action="/" class="mt-6">
		<OTPInput maxLength={6} />
		<p class="mt-6 text-center text-sm/7 text-gray-600 dark:text-gray-400">
			Har du ikke modtaget en kode?{" "}
			<button
				type="button"
				class="font-semibold text-gray-950 underline decoration-gray-950/25 underline-offset-2 hover:decoration-gray-950/50 dark:text-white dark:decoration-white/25 dark:hover:decoration-white/50"
			>
				Send en ny kode
			</button>
		</p>
		<button
			type="submit"
			class:list={["mt-6 w-full rounded-full px-3.5 py-2 text-sm/6 font-semibold", primaryButton, focusRing]}
		>
			Bekræft
		</button>
	</form>
	<p class="mt-6 text-center text-sm/7 dark:text-gray-400">
		<a
			href="/login"
			class="font-semibold text-gray-950 dark:text-white"
		>
			Brug en anden e-mail
		</a>
	</p>
</AuthLayout>
