---
interface Item {
	label: string;
	href?: string;
}

interface Props {
	items: Item[];
}

const { items } = Astro.props;
const siteUrl = Astro.site?.origin ?? "https://kasperinvest.dk";
const breadcrumbSchema = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: items.map((item, index) => ({
		"@type": "ListItem",
		position: index + 1,
		name: item.label,
		item: item.href ? new URL(item.href, siteUrl).href : new URL(Astro.url.pathname, siteUrl).href,
	})),
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
<nav aria-label="Breadcrumb" class="flex items-center gap-x-2 text-sm/6">
	{items.map((item, i) => (
		<>
			{i > 0 && <span class="text-gray-950/25 dark:text-white/25">/</span>}
			{item.href ? (
				<a href={item.href} class="min-w-0 shrink-0 text-gray-950 dark:text-white">{item.label}</a>
			) : (
				<span class="min-w-0 truncate text-gray-600 dark:text-gray-400">{item.label}</span>
			)}
		</>
	))}
</nav>
