---
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import LinkCard from "@/components/LinkCard.astro";
import PageHeader from "@/components/PageHeader.astro";
import { getPlatformsByKind } from "@/data/platforms";
import CenteredLayout from "@/layouts/CenteredLayout.astro";
import { sectionDescriptions } from "@/lib/navigation";

const groups = [
	{ id: "udbydere", title: "Udbydere", platforms: getPlatformsByKind("provider") },
	{ id: "sammenligninger", title: "Sammenligninger", platforms: getPlatformsByKind("comparison") },
];
---

<CenteredLayout
	title="Investeringsplatforme - KasperInvest"
	description={sectionDescriptions.platforme}
>
	<Breadcrumbs slot="breadcrumbs" items={[{ label: "KasperInvest", href: "/" }, { label: "Platforme" }]} />

	<PageHeader title="Investeringsplatforme">
		Valget af investeringsplatform har betydning for dine omkostninger, dine muligheder og din daglige oplevelse som investor. Her finder du traditionelle banker, robo-advisors og internationale handelsplatforme. Begynd med <a href="/platforme/nordnet-vs-saxo-bank" class="underline">Nordnet vs. Saxo Bank</a>, eller sammenlign automatisk investering i <a href="/guides/bedste-maanedsopsparing" class="underline">Bedste månedsopsparing</a>.
	</PageHeader>

	{groups.map((group) => (
		<section aria-labelledby={group.id} class="mt-10">
			<h2 id={group.id} class="text-xl/8 font-semibold tracking-tight text-gray-950 dark:text-white">
				{group.title}
			</h2>
			<div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
				{group.platforms.map((p) => (
					<LinkCard href={`/platforme/${p.id}`} title={p.title} description={p.description} headingLevel={3} />
				))}
			</div>
		</section>
	))}
</CenteredLayout>
