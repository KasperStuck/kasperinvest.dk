---
import PageHeader from "@/components/PageHeader.astro";
import { getElection, getElections } from "@/data/elections";
import ArticleIcon from "@/icons/ArticleIcon.astro";
import ElectionLayout from "@/layouts/ElectionLayout.astro";

export function getStaticPaths() {
	return getElections().map((election) => ({
		params: { year: String(election.year) },
	}));
}

const { year } = Astro.params;
const election = getElection(Number(year));

if (!election) {
	return new Response(null, { status: 404, statusText: "Not Found" });
}

const breadcrumbItems = [
	{ label: "KasperInvest", href: "/" },
	{ label: "Folketingsvalg", href: "/folketingsvalg", hideOnMobile: true },
	{ label: String(election.year) },
];
---

<ElectionLayout
	title={`${election.title} - KasperInvest`}
	description={election.description}
	breadcrumbItems={breadcrumbItems}
	election={election}
>
	<div class="mx-auto max-w-2xl pb-10 sm:pb-14 lg:max-w-5xl">
		<PageHeader title={election.title}>{election.description}</PageHeader>

		<ol class="mt-10 space-y-4">
			{election.articles.map((article) => (
				<li>
					<div class="flow-root">
						<a
							href={`/folketingsvalg/${election.year}/${article.id}`}
							class="-mx-3 -my-2 flex items-start gap-3 rounded-xl px-3 py-2 text-sm/7 hover:bg-gray-950/4 dark:hover:bg-white/5"
						>
							<div class="flex h-lh shrink items-center">
								<ArticleIcon class="text-gray-950 dark:text-white" />
							</div>
							<div>
								<div>
									<span class="font-semibold text-gray-950 dark:text-white">
										{article.title}
									</span>
								</div>
								<p class="text-gray-700 dark:text-gray-400">{article.description}</p>
							</div>
						</a>
					</div>
				</li>
			))}
		</ol>
	</div>
</ElectionLayout>
