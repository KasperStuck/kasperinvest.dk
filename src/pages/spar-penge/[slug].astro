---
import { captureException } from "@sentry/astro";

import Breadcrumbs from "@/components/Breadcrumbs.astro";
import PageHeader from "@/components/PageHeader.astro";
import ProviderCard from "@/components/ProviderCard.astro";
import { getSavingsCategory } from "@/data/savings";
import CenteredLayout from "@/layouts/CenteredLayout.astro";
import { serviceUnavailable } from "@/lib/http";

let category: Awaited<ReturnType<typeof getSavingsCategory>> = null;
try {
	category = Astro.params.slug ? await getSavingsCategory(Astro.params.slug) : null;
} catch (error) {
	captureException(error);
	console.warn("[spar-penge] Kunne ikke hente kategori", error);
	const response = serviceUnavailable(
		"Sammenligningen kan ikke hentes lige nu. Prøv igen om få minutter.",
	);
	Astro.response.status = response.status;
	return response;
}
if (!category) return new Response(null, { status: 404, statusText: "Not Found" });
---

<CenteredLayout
	title={`${category.title} - Spar penge - KasperInvest`}
	description={category.description}
>
	<Breadcrumbs
		slot="breadcrumbs"
		schema
		hideRootOnMobile
		items={[
			{ label: "KasperInvest", href: "/" },
			{ label: "Spar penge", href: "/spar-penge" },
			{ label: category.title },
		]}
	/>

	<PageHeader title={category.title}>{category.intro ?? category.description}</PageHeader>

	<div class="mt-10 space-y-4">
		{category.providers.map((p) => (
			<ProviderCard provider={p} />
		))}
	</div>
</CenteredLayout>
