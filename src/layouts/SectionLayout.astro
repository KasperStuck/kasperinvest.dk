---
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import Footer from "@/components/Footer.astro";
import Navbar from "@/components/Navbar.astro";
import { getGlossaryTermsByLetter } from "@/data/glossary";
import ArticleIcon from "@/icons/ArticleIcon.astro";
import CloseIcon from "@/icons/CloseIcon.astro";
import SidebarIcon from "@/icons/SidebarIcon.astro";
import { type BreadcrumbItem, focusRing, samePath } from "@/lib/navigation";
import BaseLayout from "./BaseLayout.astro";

interface SidebarItem {
	id: string;
	title: string;
	href: string;
}

interface Props {
	title?: string;
	description?: string;
	breadcrumbItems?: BreadcrumbItem[];
	sectionTitle: string;
	sidebarItems: SidebarItem[];
	groupByLetter?: boolean;
	canonical?: string;
	noindex?: boolean;
	ogType?: "website" | "article" | "profile";
	image?: string;
	isGlossaryCompact?: boolean;
}

const {
	title,
	description,
	breadcrumbItems = [],
	sectionTitle,
	sidebarItems,
	groupByLetter = false,
	canonical,
	noindex,
	ogType,
	image,
	isGlossaryCompact = false,
} = Astro.props;
const pathname = Astro.url.pathname;
const isActive = (href: string) => samePath(pathname, href);

const letters = isGlossaryCompact
	? Object.keys(getGlossaryTermsByLetter()).sort((a, b) => a.localeCompare(b, "da"))
	: [];

// Group items by first letter if requested
type GroupedItems = { letter: string; items: SidebarItem[] }[];
const groupedItems: GroupedItems | null = groupByLetter
	? Object.entries(
			sidebarItems.reduce<Record<string, SidebarItem[]>>((acc, item) => {
				const first = item.title[0].toUpperCase();
				const letter = /\d/.test(first) ? "0-9" : first;
				if (!acc[letter]) acc[letter] = [];
				acc[letter].push(item);
				return acc;
			}, {}),
		).map(([letter, items]) => ({ letter, items }))
	: null;

const itemClass = (active: boolean) =>
	active
		? "bg-gray-950/5 font-semibold text-gray-950 dark:bg-white/5 dark:text-white"
		: "text-gray-700 hover:bg-gray-950/4 dark:text-gray-400 dark:hover:bg-white/5";
const iconClass = (active: boolean) =>
	active ? "text-gray-950 dark:text-white" : "text-gray-400 dark:text-gray-500";
---

<BaseLayout title={title} description={description} canonical={canonical} noindex={noindex} ogType={ogType} image={image}>
	<Navbar />
	<div class="flex min-h-[calc(100dvh-4rem)]">
		<!-- Desktop Sidebar -->
		<aside class="hidden w-72 shrink-0 border-r border-gray-950/10 dark:border-white/10 lg:block">
			<div class="sticky top-16 flex h-[calc(100dvh-4rem)] flex-col overflow-y-auto px-4 py-6">
				<!-- Search / Alphabet Navigation -->
				{isGlossaryCompact ? (
					<div class="mb-6 px-1">
						<h4 class="text-xs/6 font-semibold text-gray-600 dark:text-gray-400 mb-2">Søg på bogstav</h4>
						<div class="grid grid-cols-7 gap-1 text-center">
							{letters.map((letter) => (
								<a
									href={`/ordbog#${letter}`}
									class="inline-flex size-7 items-center justify-center rounded-md text-[11px] font-semibold text-gray-700 bg-gray-950/4 hover:bg-gray-950/8 dark:bg-white/5 dark:text-gray-300 dark:hover:bg-white/10 transition-colors"
								>
									{letter}
								</a>
							))}
						</div>
						<div class="mt-3">
							<a
								href="/ordbog"
								class="flex items-center justify-center gap-1.5 rounded-lg border border-gray-950/10 dark:border-white/10 px-3 py-1.5 text-xs font-semibold text-gray-950 hover:bg-gray-950/4 dark:text-white dark:hover:bg-white/5 w-full text-center transition-all"
							>
								Se alle ord (A-Å) &rarr;
							</a>
						</div>
					</div>
				) : (
					<div class="mb-4 px-1">
						<div class="relative">
							<svg class="pointer-events-none absolute left-2.5 top-1/2 size-4 -translate-y-1/2 text-gray-400 dark:text-gray-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
							</svg>
							<input
								type="text"
								placeholder="Filtrer..."
								aria-label={`Filtrer ${sectionTitle.toLowerCase()}`}
								data-sidebar-search="desktop"
								class:list={["w-full rounded-lg border border-gray-950/10 bg-transparent py-1.5 pl-9 pr-9 text-sm/6 text-gray-950 placeholder:text-gray-400 dark:border-white/10 dark:text-white dark:placeholder:text-gray-500", focusRing]}
							/>
							<kbd class="pointer-events-none absolute right-2 top-1/2 -translate-y-1/2 rounded border border-gray-950/10 px-1.5 text-[10px] font-medium text-gray-400 dark:border-white/10 dark:text-gray-500" data-search-kbd>
								<span data-search-kbd-prefix></span>K
							</kbd>
						</div>
					</div>
				)}
				<nav aria-label={sectionTitle} class="flex-1 space-y-6">
					<div>
						<h3 class="px-2 text-xs/6 font-semibold text-gray-600 dark:text-gray-400">
							{sectionTitle}
						</h3>
						<ul class="mt-1 space-y-0.5" data-sidebar-list="desktop">
							{groupedItems ? groupedItems.map((group) => (
								<>
									<li data-sidebar-letter class="mt-4 first:mt-0 px-2 text-xs/6 font-bold text-gray-950 dark:text-white">{group.letter}</li>
									{group.items.map((item) => (
										<li data-sidebar-item data-title={item.title.toLowerCase()} data-letter={group.letter}>
											<a
												href={item.href}
												aria-current={isActive(item.href) ? "page" : undefined}
												class:list={["-mx-1 flex items-center gap-2 rounded-lg px-3 py-1 text-sm/7", itemClass(isActive(item.href))]}
											>
												<ArticleIcon class={iconClass(isActive(item.href))} />
												<span class="truncate">{item.title}</span>
											</a>
										</li>
									))}
								</>
							)) : sidebarItems.map((item) => (
								<li data-sidebar-item data-title={item.title.toLowerCase()}>
									<a
										href={item.href}
										aria-current={isActive(item.href) ? "page" : undefined}
										class:list={["-mx-1 flex items-center gap-2 rounded-lg px-3 py-1 text-sm/7", itemClass(isActive(item.href))]}
									>
										<ArticleIcon class={iconClass(isActive(item.href))} />
										<span class="truncate">{item.title}</span>
									</a>
								</li>
							))}
						</ul>
						<p class="mt-3 hidden px-2 text-sm/6 text-gray-400 dark:text-gray-500" data-sidebar-empty="desktop">
							Ingen resultater
						</p>
					</div>
					<div class="border-t border-gray-950/10 pt-4 dark:border-white/10">
						<a
							href="/"
							class="-mx-1 flex items-center gap-2 rounded-lg px-3 py-1 text-sm/7 text-gray-600 hover:bg-gray-950/4 dark:text-gray-400 dark:hover:bg-white/5"
						>
							&larr; Tilbage til kurset
						</a>
					</div>
				</nav>
			</div>
		</aside>

		<!-- Mobile Sidebar Drawer -->
		<dialog
			id="mobile-sidebar"
			aria-labelledby="mobile-sidebar-title"
			class="h-dvh max-h-none w-full max-w-xs bg-white text-gray-950 ring ring-gray-950/10 backdrop:bg-gray-950/25 lg:hidden dark:bg-gray-950 dark:text-white dark:ring-white/10"
			data-drawer
		>
			<div class="h-full overflow-y-auto overscroll-contain px-4 py-3">
				<div class="mb-4 flex h-10 items-center justify-between pl-2">
					<h2 id="mobile-sidebar-title" class="text-base/7 font-semibold">Emneoversigt</h2>
					<button
						type="button"
						class:list={["-mr-2.5 inline-flex size-11 cursor-pointer items-center justify-center rounded-md hover:bg-gray-950/5 dark:hover:bg-white/5", focusRing]}
						data-close-dialog
						aria-label="Luk emneoversigt"
					>
						<CloseIcon />
					</button>
				</div>
				<!-- Mobile Search / Alphabet Navigation -->
				{isGlossaryCompact ? (
					<div class="mb-6 px-1">
						<h4 class="text-xs/6 font-semibold text-gray-600 dark:text-gray-400 mb-2">Søg på bogstav</h4>
						<div class="grid grid-cols-7 gap-1 text-center">
							{letters.map((letter) => (
								<a
									href={`/ordbog#${letter}`}
									class="inline-flex size-7 items-center justify-center rounded-md text-[11px] font-semibold text-gray-700 bg-gray-950/4 hover:bg-gray-950/8 dark:bg-white/5 dark:text-gray-300 dark:hover:bg-white/10 transition-colors"
								>
									{letter}
								</a>
							))}
						</div>
						<div class="mt-3">
							<a
								href="/ordbog"
								class="flex items-center justify-center gap-1.5 rounded-lg border border-gray-950/10 dark:border-white/10 px-3 py-1.5 text-xs font-semibold text-gray-950 hover:bg-gray-950/4 dark:text-white dark:hover:bg-white/5 w-full text-center transition-all"
							>
								Se alle ord (A-Å) &rarr;
							</a>
						</div>
					</div>
				) : (
					<div class="mb-4 px-1">
						<div class="relative">
							<svg class="pointer-events-none absolute left-2.5 top-1/2 size-4 -translate-y-1/2 text-gray-400 dark:text-gray-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
							</svg>
							{/* autofocus: the drawer focuses the filter when it opens */}
							<input
								type="text"
								placeholder="Filtrer..."
								aria-label={`Filtrer ${sectionTitle.toLowerCase()}`}
								autofocus
								data-sidebar-search="mobile"
								class:list={["w-full rounded-lg border border-gray-950/10 bg-transparent py-1.5 pl-9 pr-3 text-sm/6 text-gray-950 placeholder:text-gray-400 dark:border-white/10 dark:text-white dark:placeholder:text-gray-500", focusRing]}
							/>
						</div>
					</div>
				)}
				<nav aria-label={sectionTitle} class="space-y-6">
					<div>
						<h3 class="px-2 text-xs/6 font-semibold text-gray-600 dark:text-gray-400">
							{sectionTitle}
						</h3>
						<ul class="mt-1 space-y-0.5" data-sidebar-list="mobile">
							{groupedItems ? groupedItems.map((group) => (
								<>
									<li data-sidebar-letter class="mt-4 first:mt-0 px-2 text-xs/6 font-bold text-gray-950 dark:text-white">{group.letter}</li>
									{group.items.map((item) => (
										<li data-sidebar-item data-title={item.title.toLowerCase()} data-letter={group.letter}>
											<a
												href={item.href}
												aria-current={isActive(item.href) ? "page" : undefined}
												class:list={["flex min-h-11 items-center gap-2 rounded-lg px-3 py-1 text-sm/7", itemClass(isActive(item.href))]}
											>
												<ArticleIcon class={iconClass(isActive(item.href))} />
												<span class="truncate">{item.title}</span>
											</a>
										</li>
									))}
								</>
							)) : sidebarItems.map((item) => (
								<li data-sidebar-item data-title={item.title.toLowerCase()}>
									<a
										href={item.href}
										aria-current={isActive(item.href) ? "page" : undefined}
										class:list={["flex min-h-11 items-center gap-2 rounded-lg px-3 py-1 text-sm/7", itemClass(isActive(item.href))]}
									>
										<ArticleIcon class={iconClass(isActive(item.href))} />
										<span class="truncate">{item.title}</span>
									</a>
								</li>
							))}
						</ul>
						<p class="mt-3 hidden px-2 text-sm/6 text-gray-400 dark:text-gray-500" data-sidebar-empty="mobile">
							Ingen resultater
						</p>
					</div>
					<div class="border-t border-gray-950/10 pt-4 dark:border-white/10">
						<a
							href="/"
							class="flex min-h-11 items-center gap-2 rounded-lg px-3 py-1 text-sm/7 text-gray-600 hover:bg-gray-950/4 dark:text-gray-400 dark:hover:bg-white/5"
						>
							&larr; Tilbage til kurset
						</a>
					</div>
				</nav>
			</div>
		</dialog>

		<!-- Main Content -->
		<div class="flex min-w-0 flex-1 flex-col">
			<main class="flex-1 px-4 pb-16 sm:px-6">
				<div class="flex items-center gap-x-3 py-3">
					<button
						type="button"
						class:list={["inline-flex min-h-11 shrink-0 cursor-pointer items-center gap-x-2 rounded-md border border-gray-950/10 px-3 text-sm/6 font-medium text-gray-950 hover:bg-gray-950/5 lg:hidden dark:border-white/10 dark:text-white dark:hover:bg-white/5", focusRing]}
						data-open-dialog="mobile-sidebar"
						aria-haspopup="dialog"
						aria-controls="mobile-sidebar"
					>
						<SidebarIcon />
						Emneoversigt
					</button>
					{breadcrumbItems.length > 0 && <Breadcrumbs items={breadcrumbItems} hideRootOnMobile />}
				</div>
				<slot />
			</main>
			<Footer />
		</div>
	</div>
</BaseLayout>

<script>
	import { setDrawerOpen } from "@/lib/navigation";

	// Sidebar search filter
	document.querySelectorAll<HTMLInputElement>("[data-sidebar-search]").forEach((input) => {
		const variant = input.dataset.sidebarSearch!;
		const list = document.querySelector(`[data-sidebar-list="${variant}"]`);
		const empty = document.querySelector(`[data-sidebar-empty="${variant}"]`);
		if (!list) return;

		const items = list.querySelectorAll<HTMLLIElement>("[data-sidebar-item]");
		const letterHeaders = list.querySelectorAll<HTMLLIElement>("[data-sidebar-letter]");

		input.addEventListener("input", () => {
			const query = input.value.toLowerCase().trim();
			let visible = 0;

			items.forEach((item) => {
				const title = item.dataset.title || "";
				const match = !query || title.includes(query);
				item.style.display = match ? "" : "none";
				if (match) visible++;
			});

			// Hide letter headers when no items in that group are visible
			letterHeaders.forEach((header) => {
				const letter = header.textContent?.trim() || "";
				const hasVisible = Array.from(items).some(
					(item) => item.dataset.letter === letter && item.style.display !== "none"
				);
				header.style.display = hasVisible ? "" : "none";
			});

			empty?.classList.toggle("hidden", visible > 0);
		});

		// Clear on Escape
		input.addEventListener("keydown", (e) => {
			if (e.key === "Escape" && input.value) {
				e.preventDefault();
				input.value = "";
				input.dispatchEvent(new Event("input"));
			}
		});
	});

	// Cmd/Ctrl+K to focus desktop search
	const kbdPrefix = document.querySelector("[data-search-kbd-prefix]");
	if (kbdPrefix) {
		kbdPrefix.textContent = navigator.userAgent.includes("Mac") ? "⌘" : "Ctrl+";
	}

	document.addEventListener("keydown", (e) => {
		if ((e.metaKey || e.ctrlKey) && e.key === "k") {
			const desktopSearch = document.querySelector<HTMLInputElement>('[data-sidebar-search="desktop"]');
			const mobileSearch = document.querySelector<HTMLInputElement>('[data-sidebar-search="mobile"]');
			const target = window.innerWidth >= 1024 ? desktopSearch : mobileSearch;
			// Compact glossary pages have no filter; leave the shortcut to the browser there.
			if (!target) return;
			e.preventDefault();

			const drawer = document.getElementById("mobile-sidebar");
			if (window.innerWidth < 1024 && drawer instanceof HTMLDialogElement) {
				setDrawerOpen(drawer, true);
			}

			target.focus();
			target.select();
		}
	});
</script>
