---
import LinkCard from "@/components/LinkCard.astro";
import { sectionMeta } from "@/data/articles";
import { getModules, type Module } from "@/data/lessons";
import ArticleIcon from "@/icons/ArticleIcon.astro";
import BookIcon from "@/icons/BookIcon.astro";
import CirclePlayIcon from "@/icons/CirclePlayIcon.astro";
import ClockIcon from "@/icons/ClockIcon.astro";
import LessonsIcon from "@/icons/LessonsIcon.astro";
import PlayIcon from "@/icons/PlayIcon.astro";
import CenteredLayout from "@/layouts/CenteredLayout.astro";
import { focusRing, primaryButton, sectionDescriptions } from "@/lib/navigation";

const modules = getModules();
const lessons = modules.flatMap(({ lessons }) => lessons);
const duration = lessons.reduce((sum, { video }) => sum + (video?.duration ?? 0), 0);

// Entry cards reuse each section's own meta description; no new copy.
const sections = [
	{ href: "/guides", title: "Guides", description: sectionMeta.guides.description },
	{ href: "/etf", title: "ETF", description: sectionMeta.etf.description },
	{ href: "/pension", title: "Pension", description: sectionDescriptions.pension },
	{ href: "/platforme", title: "Platforme", description: sectionDescriptions.platforme },
	{ href: "/ordbog", title: "Ordbog", description: sectionDescriptions.ordbog },
	{ href: "/youtube", title: "YouTube", description: sectionDescriptions.youtube },
	{ href: "/spar-penge", title: "Spar penge", description: sectionDescriptions.sparPenge },
	{ href: "/skat", title: "Skat", description: sectionMeta.skat.description },
];

function formatDuration(seconds: number): string {
	const h = Math.floor(seconds / 3600);
	const m = Math.floor((seconds % 3600) / 60);
	return h > 0 ? (m > 0 ? `${h} t ${m} min` : `${h} t`) : `${m} min`;
}

function formatLessonDuration(seconds: number): string {
	const m = Math.floor(seconds / 60);
	const s = seconds % 60;
	return `${m}:${s.toString().padStart(2, "0")}`;
}
---

<CenteredLayout
	title="Gratis investeringskursus for begyndere - KasperInvest"
	description="Lær at investere ansvarligt i Danmark via en metodisk proces: privatøkonomi, strategi, produkter, handel, analyse, skat og nedsparing."
>
	<div class="py-10 sm:py-14">
		<h1 class="max-w-2xl text-3xl/10 font-semibold tracking-tight text-gray-950 dark:text-white sm:text-4xl/12">Gratis investeringskursus for begyndere</h1>
		<p class="mt-5 max-w-lg text-base/7 text-pretty text-gray-600 dark:text-gray-400">
			Lær at investere ansvarligt i Danmark via en metodisk proces:
			privatøkonomi, strategi, produkter, handel, analyse, skat og nedsparing.
		</p>
		<div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-3 text-sm/7 font-semibold text-gray-950 sm:gap-3 dark:text-white">
			<div class="flex items-center gap-1.5">
				<BookIcon class="text-gray-950/40 dark:text-white/40" />
				{modules.length} moduler
			</div>
			<span class="hidden text-gray-950/25 sm:inline dark:text-white/25">
				&middot;
			</span>
			<div class="flex items-center gap-1.5">
				<LessonsIcon class="text-gray-950/40 dark:text-white/40" />
				{lessons.length} lektioner
			</div>
			{duration > 0 && (
				<>
					<span class="hidden text-gray-950/25 sm:inline dark:text-white/25">
						&middot;
					</span>
					<div class="flex items-center gap-1.5">
						<ClockIcon class="text-gray-950/40 dark:text-white/40" />
						{formatDuration(duration)}
					</div>
				</>
			)}
		</div>
		<div class="mt-8">
			<a
				href={`/${modules[0].lessons[0].id}`}
				class:list={["inline-flex items-center gap-x-2 rounded-full px-4 py-1.5 text-sm/7 font-semibold", primaryButton, focusRing]}
			>
				<PlayIcon />
				Start kurset
			</a>
		</div>
	</div>

	<section aria-labelledby="udforsk" class="border-t border-gray-950/10 py-10 sm:py-14 dark:border-white/10">
		<h2 id="udforsk" class="text-xl/8 font-semibold tracking-tight text-gray-950 dark:text-white">Udforsk</h2>
		<div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
			{sections.map((section) => (
				<LinkCard href={section.href} title={section.title} description={section.description} headingLevel={3} />
			))}
		</div>
	</section>

	<nav aria-label="Kursets moduler" class="border-t border-gray-950/10 pt-10 sm:pt-14 dark:border-white/10">
		<ul class="flex flex-wrap gap-2">
			{modules.map((module: Module, index: number) => (
				<li>
					<a
						href={`#${module.id}`}
						class:list={["inline-flex min-h-9 items-center rounded-full border border-gray-950/10 px-3 text-sm/6 font-medium text-gray-700 hover:border-brand-700/40 hover:text-gray-950 dark:border-white/10 dark:text-gray-300 dark:hover:border-brand-400/40 dark:hover:text-white", focusRing]}
					>
						Del {index + 1}<span class="sr-only">: {module.title}</span>
					</a>
				</li>
			))}
		</ul>
	</nav>

	<div class="mt-10 grid grid-cols-1 gap-y-16 sm:mt-14">
		{modules.map((module: Module, index: number) => (
			<section
				id={module.id}
				class="grid grid-cols-4 border-t border-gray-950/10 dark:border-white/10"
			>
				<div class="col-span-full sm:col-span-1">
					<div class="-mt-px inline-flex border-t border-gray-950 pt-px dark:border-white">
						<div class="pt-4 text-sm/7 font-semibold text-gray-950 sm:pt-10 dark:text-white">
							<p>Del {index + 1}</p>
						</div>
					</div>
				</div>
				<div class="col-span-full pt-6 sm:col-span-3 sm:pt-10">
					<div class="max-w-2xl">
						<h2 class="text-2xl/7 font-medium tracking-tight text-pretty text-gray-950 dark:text-white">
							{module.title}
						</h2>
						<p class="mt-4 text-base/7 text-gray-700 sm:text-sm/7 dark:text-gray-400">
							{module.description}
						</p>
						<ol class="mt-6 space-y-4">
							{module.lessons.map((lesson) => {
								const Icon = lesson.video ? CirclePlayIcon : ArticleIcon;
								return (
									<li>
										<div class="flow-root">
											<a
												href={`/${lesson.id}`}
												class:list={["-mx-3 -my-2 flex items-start gap-3 rounded-xl px-3 py-2 text-sm/7 hover:bg-gray-950/4 dark:hover:bg-white/5", focusRing]}
											>
												<div class="flex h-lh shrink items-center">
													<Icon class="text-gray-950 dark:text-white" />
												</div>
												<div>
													<div>
														<span class="font-semibold text-gray-950 dark:text-white">
															{lesson.title}
														</span>
														{lesson.video?.duration && (
															<>
																<span class="mx-2 hidden text-gray-950/25 sm:inline dark:text-white/25">
																	&middot;
																</span>
																<span class="hidden text-gray-600 sm:inline dark:text-gray-400">
																	{formatLessonDuration(lesson.video.duration)}
																</span>
															</>
														)}
													</div>
													<p class="text-gray-700 dark:text-gray-400">{lesson.description}</p>
													{lesson.video?.duration && (
														<div class="text-gray-500 sm:hidden dark:text-gray-400">
															{formatLessonDuration(lesson.video.duration)}
														</div>
													)}
												</div>
											</a>
										</div>
									</li>
								);
							})}
						</ol>
					</div>
				</div>
			</section>
		))}
	</div>
</CenteredLayout>
