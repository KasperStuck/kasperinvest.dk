---
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import LinkCard from "@/components/LinkCard.astro";
import PageHeader from "@/components/PageHeader.astro";
import { getArticles, sectionMeta } from "@/data/articles";
import CenteredLayout from "@/layouts/CenteredLayout.astro";

const section = sectionMeta.guides;
const articles = getArticles("guides");
---
<CenteredLayout title="Investeringsguides - KasperInvest" description={section.description}>
	<Breadcrumbs slot="breadcrumbs" items={[{ label: "KasperInvest", href: "/" }, { label: section.title }]} />
	<PageHeader title={section.title}>{section.description}</PageHeader>
	<div class="mt-10 grid gap-4 sm:grid-cols-2">
		{articles.map((article) => <LinkCard href={`/guides/${article.id}`} title={article.title} description={article.description} />)}
	</div>
</CenteredLayout>
