---
import Logo from "@/components/Logo.astro";
import { getGlossaryTerms } from "@/data/glossary";
import { getModules } from "@/data/lessons";
import { getPensionTypes } from "@/data/pension";
import { getPlatforms } from "@/data/platforms";
import { focusRing } from "@/lib/navigation";

const modules = getModules();
const pensionTypes = getPensionTypes();
const platforms = getPlatforms();
const glossaryTerms = getGlossaryTerms().slice(0, 5);

const heading = "text-sm/6 font-semibold text-gray-950 dark:text-white";
const link = [
	"rounded-sm text-sm/6 text-gray-600 hover:text-gray-950 dark:text-gray-400 dark:hover:text-white",
	focusRing,
];
const moreLink = [
	"rounded-sm text-sm/6 font-medium text-gray-950 hover:text-gray-700 dark:text-white dark:hover:text-gray-300",
	focusRing,
];
const moreLinks = [
	{ href: "/guides", label: "Investeringsguides" },
	{ href: "/etf", label: "ETF'er" },
	{ href: "/skat", label: "Skat af investering" },
	{ href: "/spar-penge", label: "Spar penge" },
	{ href: "/youtube", label: "YouTube" },
	{ href: "/resources", label: "Ressourcer" },
	{ href: "/folketingsvalg", label: "Folketingsvalg" },
	{ href: "/sitemap", label: "Sitemap" },
];
---

<footer class="border-t border-gray-950/10 bg-gray-50 dark:border-white/10 dark:bg-white/[0.03]">
	<div class="mx-auto max-w-7xl px-4 py-10 sm:px-6">
		<div class="flex flex-col gap-2 lg:flex-row lg:items-baseline lg:gap-6">
			<a href="/" class:list={["shrink-0 self-start rounded-sm", focusRing]}>
				<Logo class="text-lg text-gray-950 dark:text-white" />
			</a>
			<p class="max-w-xl text-sm/6 text-gray-600 dark:text-gray-400">
				KasperInvest hjælper dig med at lære at investere gennem gratis kurser, guides og værktøjer.
			</p>
		</div>

		<div class="mt-8 grid grid-cols-2 gap-x-8 gap-y-10 md:grid-cols-4 lg:grid-cols-6">
			<div class="col-span-2">
				<h3 class={heading}><a href="/" class:list={["rounded-sm", focusRing]}>Kursus</a></h3>
				<ul class="mt-3 space-y-2">
					{modules.map((mod, i) => (
						<li>
							<a href={`/${mod.lessons[0].id}`} class:list={link}>
								Del {i + 1}: {mod.title}
							</a>
						</li>
					))}
					<li>
						<a href="/" class:list={moreLink}>Se alle lektioner &rarr;</a>
					</li>
				</ul>
			</div>

			<div>
				<h3 class={heading}><a href="/pension" class:list={["rounded-sm", focusRing]}>Pension</a></h3>
				<ul class="mt-3 space-y-2">
					{pensionTypes.map((p) => (
						<li><a href={`/pension/${p.id}`} class:list={link}>{p.title}</a></li>
					))}
				</ul>
			</div>

			<div>
				<h3 class={heading}><a href="/platforme" class:list={["rounded-sm", focusRing]}>Platforme</a></h3>
				<ul class="mt-3 space-y-2">
					{platforms.map((p) => (
						<li><a href={`/platforme/${p.id}`} class:list={link}>{p.title}</a></li>
					))}
				</ul>
			</div>

			<div>
				<h3 class={heading}><a href="/ordbog" class:list={["rounded-sm", focusRing]}>Ordbog</a></h3>
				<ul class="mt-3 space-y-2">
					{glossaryTerms.map((t) => (
						<li><a href={`/ordbog/${t.id}`} class:list={link}>{t.title}</a></li>
					))}
					<li>
						<a href="/ordbog" class:list={moreLink}>Se alle &rarr;</a>
					</li>
				</ul>
			</div>

			<div>
				<h3 class={heading}>Mere</h3>
				<ul class="mt-3 space-y-2">
					{moreLinks.map(({ href, label }) => (
						<li><a href={href} class:list={link}>{label}</a></li>
					))}
				</ul>
			</div>
		</div>

		<div class="mt-10 flex flex-col gap-2 border-t border-gray-950/10 pt-6 lg:flex-row lg:items-baseline lg:justify-between lg:gap-8 dark:border-white/10">
			<p class="text-sm/6 text-gray-600 dark:text-gray-400">
				&copy; {new Date().getFullYear()} KasperInvest. Indholdet er kun til uddannelsesformål og udgør ikke finansiel rådgivning.
			</p>
			<nav aria-label="Juridisk og redaktionelt" class="flex shrink-0 flex-wrap gap-x-4 gap-y-2 text-sm/6">
				<a href="/om" class:list={link}>Om KasperInvest</a>
				<a href="/redaktionel-metode" class:list={link}>Redaktionel metode</a>
				<a href="/affiliatepolitik" class:list={link}>Affiliatepolitik</a>
			</nav>
		</div>
	</div>
</footer>
