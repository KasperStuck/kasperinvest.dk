---
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import Footer from "@/components/Footer.astro";
import Navbar from "@/components/Navbar.astro";
import type { Election } from "@/data/elections";
import ArticleIcon from "@/icons/ArticleIcon.astro";
import CloseIcon from "@/icons/CloseIcon.astro";
import SidebarIcon from "@/icons/SidebarIcon.astro";
import { type BreadcrumbItem, focusRing, samePath } from "@/lib/navigation";
import BaseLayout from "./BaseLayout.astro";

interface Props {
	title?: string;
	description?: string;
	breadcrumbItems?: BreadcrumbItem[];
	election: Election;
}

const { title, description, breadcrumbItems = [], election } = Astro.props;
const pathname = Astro.url.pathname;
const articles = election.articles.map((article) => {
	const href = `/folketingsvalg/${election.year}/${article.id}`;
	return { href, title: article.title, active: samePath(pathname, href) };
});

const itemClass = (active: boolean) =>
	active
		? "bg-gray-950/5 font-semibold text-gray-950 dark:bg-white/5 dark:text-white"
		: "text-gray-700 hover:bg-gray-950/4 dark:text-gray-400 dark:hover:bg-white/5";
const iconClass = (active: boolean) =>
	active ? "text-gray-950 dark:text-white" : "text-gray-400 dark:text-gray-500";
---

<BaseLayout title={title} description={description}>
	<Navbar />
	<div class="flex min-h-[calc(100dvh-4rem)]">
		<!-- Desktop Sidebar -->
		<aside class="hidden w-72 shrink-0 border-r border-gray-950/10 dark:border-white/10 lg:block">
			<nav aria-label={election.title} class="sticky top-16 h-[calc(100dvh-4rem)] space-y-6 overflow-y-auto px-4 py-6">
				<div>
					<h3 class="px-2 text-xs/6 font-semibold text-gray-600 dark:text-gray-400">
						{election.title}
					</h3>
					<ul class="mt-1 space-y-0.5">
						{articles.map((article) => (
							<li>
								<a
									href={article.href}
									aria-current={article.active ? "page" : undefined}
									class:list={["-mx-1 flex items-center gap-2 rounded-lg px-3 py-1 text-sm/7", itemClass(article.active)]}
								>
									<ArticleIcon class={iconClass(article.active)} />
									<span class="truncate">{article.title}</span>
								</a>
							</li>
						))}
					</ul>
				</div>
				<div class="border-t border-gray-950/10 pt-4 dark:border-white/10">
					<a
						href="/"
						class="-mx-1 flex items-center gap-2 rounded-lg px-3 py-1 text-sm/7 text-gray-600 hover:bg-gray-950/4 dark:text-gray-400 dark:hover:bg-white/5"
					>
						&larr; Tilbage til kurset
					</a>
				</div>
			</nav>
		</aside>

		<!-- Mobile Sidebar Drawer -->
		<dialog
			id="mobile-sidebar"
			aria-labelledby="mobile-sidebar-title"
			class="h-dvh max-h-none w-full max-w-xs bg-white text-gray-950 ring ring-gray-950/10 backdrop:bg-gray-950/25 lg:hidden dark:bg-gray-950 dark:text-white dark:ring-white/10"
			data-drawer
		>
			<div class="h-full overflow-y-auto overscroll-contain px-4 py-3">
				<div class="flex h-10 items-center justify-between pl-2">
					<h2 id="mobile-sidebar-title" class="text-base/7 font-semibold">Emneoversigt</h2>
					<button
						type="button"
						class:list={["-mr-2.5 inline-flex size-11 cursor-pointer items-center justify-center rounded-md hover:bg-gray-950/5 dark:hover:bg-white/5", focusRing]}
						data-close-dialog
						aria-label="Luk emneoversigt"
					>
						<CloseIcon />
					</button>
				</div>
				<nav aria-label={election.title} class="mt-4 space-y-6">
					<div>
						<h3 class="px-2 text-xs/6 font-semibold text-gray-600 dark:text-gray-400">
							{election.title}
						</h3>
						<ul class="mt-1 space-y-0.5">
							{articles.map((article) => (
								<li>
									<a
										href={article.href}
										aria-current={article.active ? "page" : undefined}
										class:list={["flex min-h-11 items-center gap-2 rounded-lg px-3 py-1 text-sm/7", itemClass(article.active)]}
									>
										<ArticleIcon class={iconClass(article.active)} />
										<span class="truncate">{article.title}</span>
									</a>
								</li>
							))}
						</ul>
					</div>
					<div class="border-t border-gray-950/10 pt-4 dark:border-white/10">
						<a
							href="/"
							class="flex min-h-11 items-center gap-2 rounded-lg px-3 py-1 text-sm/7 text-gray-600 hover:bg-gray-950/4 dark:text-gray-400 dark:hover:bg-white/5"
						>
							&larr; Tilbage til kurset
						</a>
					</div>
				</nav>
			</div>
		</dialog>

		<!-- Main Content -->
		<div class="flex min-w-0 flex-1 flex-col">
			<main class="flex-1 px-4 pb-16 sm:px-6">
				<div class="flex items-center gap-x-3 py-3">
					<button
						type="button"
						class:list={["inline-flex min-h-11 shrink-0 cursor-pointer items-center gap-x-2 rounded-md border border-gray-950/10 px-3 text-sm/6 font-medium text-gray-950 hover:bg-gray-950/5 lg:hidden dark:border-white/10 dark:text-white dark:hover:bg-white/5", focusRing]}
						data-open-dialog="mobile-sidebar"
						aria-haspopup="dialog"
						aria-controls="mobile-sidebar"
					>
						<SidebarIcon />
						Emneoversigt
					</button>
					{breadcrumbItems.length > 0 && <Breadcrumbs items={breadcrumbItems} hideRootOnMobile />}
				</div>
				<slot />
			</main>
			<Footer />
		</div>
	</div>
</BaseLayout>
