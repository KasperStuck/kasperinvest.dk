---
import TextInput from "@/components/TextInput.astro";
import AuthLayout from "@/layouts/AuthLayout.astro";
import { focusRing, primaryButton } from "@/lib/navigation";
---

<AuthLayout title="Log ind - KasperInvest">
	<h1 class="sr-only">Log ind</h1>
	<form action="/otp">
		<div>
			<label
				for="email"
				class="block w-full text-sm/7 font-medium text-gray-950 dark:text-white"
			>
				E-mail
			</label>
			<TextInput type="email" id="email" required class="mt-2" />
		</div>
		<button
			type="submit"
			class:list={["mt-6 w-full rounded-full px-3.5 py-2 text-sm/6 font-semibold", primaryButton, focusRing]}
		>
			Send engangskode
		</button>
	</form>
</AuthLayout>
