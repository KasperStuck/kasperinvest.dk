---
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import LinkCard from "@/components/LinkCard.astro";
import PageHeader from "@/components/PageHeader.astro";
import { getPensionTypes } from "@/data/pension";
import CenteredLayout from "@/layouts/CenteredLayout.astro";
import { sectionDescriptions } from "@/lib/navigation";

const pensionTypes = getPensionTypes();
---

<CenteredLayout
	title="Pension - KasperInvest"
	description={sectionDescriptions.pension}
>
	<Breadcrumbs slot="breadcrumbs" items={[{ label: "KasperInvest", href: "/" }, { label: "Pension" }]} />

	<PageHeader title="Pension">
		Det danske pensionssystem består af flere ordninger med forskellige regler for indbetaling, beskatning og udbetaling. Brug overblikket til at forstå dem enkeltvis, og sammenlign derefter <a href="/pension/livrente-vs-ratepension" class="underline">livrente vs. ratepension</a> og <a href="/pension/aldersopsparing-vs-ratepension" class="underline">aldersopsparing vs. ratepension</a> som dele af én samlet plan.
	</PageHeader>

	<div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
		{pensionTypes.map((p) => (
			<LinkCard href={`/pension/${p.id}`} title={p.title} description={p.description} />
		))}
	</div>
</CenteredLayout>
