---
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import LinkCard from "@/components/LinkCard.astro";
import PageHeader from "@/components/PageHeader.astro";
import { getArticles, sectionMeta } from "@/data/articles";
import CenteredLayout from "@/layouts/CenteredLayout.astro";

const section = sectionMeta.etf;
const articles = getArticles("etf");
---
<CenteredLayout title="ETF'er - guide til danske investorer - KasperInvest" description={section.description}>
	<Breadcrumbs slot="breadcrumbs" items={[{ label: "KasperInvest", href: "/" }, { label: section.title }]} />
	<PageHeader title="ETF'er for danske investorer">{section.description} Begynd med kriterierne, og kontrollér altid de aktuelle skatteregler og produktdata hos de officielle kilder.</PageHeader>
	<div class="mt-10 grid gap-4 sm:grid-cols-2">{articles.map((article) => <LinkCard href={`/etf/${article.id}`} title={article.title} description={article.description} />)}</div>
</CenteredLayout>
