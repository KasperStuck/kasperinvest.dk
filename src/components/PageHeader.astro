---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<div class="pt-6 sm:pt-10">
	<h1 class="text-3xl/10 font-semibold tracking-tight text-gray-950 sm:text-4xl/12 dark:text-white">{title}</h1>
	{Astro.slots.has("default") && (
		<p class="mt-4 max-w-2xl text-base/7 text-gray-600 dark:text-gray-400">
			<slot />
		</p>
	)}
</div>
