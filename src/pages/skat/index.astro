---
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import LinkCard from "@/components/LinkCard.astro";
import PageHeader from "@/components/PageHeader.astro";
import { getArticles, sectionMeta } from "@/data/articles";
import CenteredLayout from "@/layouts/CenteredLayout.astro";

const section = sectionMeta.skat;
const articles = getArticles("skat");
---
<CenteredLayout title="Skat af investering - KasperInvest" description={section.description}>
	<Breadcrumbs slot="breadcrumbs" items={[{ label: "KasperInvest", href: "/" }, { label: section.title }]} />
	<PageHeader title="Skat af investering">{section.description} Regler og beløbsgrænser ændrer sig; kontrollér derfor altid den konkrete situation hos Skattestyrelsen.</PageHeader>
	<div class="mt-10 grid gap-4 sm:grid-cols-2">{articles.map((article) => <LinkCard href={`/skat/${article.id}`} title={article.title} description={article.description} />)}</div>
</CenteredLayout>
