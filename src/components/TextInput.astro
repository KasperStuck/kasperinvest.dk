---
import type { HTMLAttributes } from "astro/types";
import { focusRing } from "@/lib/navigation";

type Props = HTMLAttributes<"input">;

const { type = "text", class: className, ...props } = Astro.props;
---

<input
	type={type}
	class:list={[className, "block w-full rounded-lg border border-gray-950/10 bg-transparent px-3 py-1.5 text-sm/7 text-gray-950 placeholder:text-gray-500 focus:border-gray-950/20 dark:border-white/10 dark:text-white dark:placeholder:text-gray-400 dark:focus:border-white/20", focusRing]}
	{...props}
/>
