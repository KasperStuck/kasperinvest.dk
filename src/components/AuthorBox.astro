---
interface Props {
	updatedAt?: string;
}

const { updatedAt } = Astro.props;
const formatted = updatedAt
	? new Date(updatedAt).toLocaleDateString("da-DK", {
			day: "numeric",
			month: "long",
			year: "numeric",
		})
	: null;

const link =
	"font-medium text-gray-950 underline decoration-gray-950/25 underline-offset-2 hover:decoration-gray-950 dark:text-white dark:decoration-white/25 dark:hover:decoration-white";
---

<p class="not-prose mb-8 text-sm/6 text-gray-600 dark:text-gray-400">
	Skrevet og redigeret af <a href="/om" class={link}>Kasper Stuck</a>
	<span aria-hidden="true" class="mx-1 text-gray-950/25 dark:text-white/25">&middot;</span><span class="sr-only">. </span>
	Følger KasperInvests <a href="/redaktionel-metode" class={link}>redaktionelle metode</a>
	{formatted && updatedAt && (
		<>
			<span aria-hidden="true" class="mx-1 text-gray-950/25 dark:text-white/25">&middot;</span><span class="sr-only">. </span>
			Senest opdateret og kontrolleret <time datetime={updatedAt}>{formatted}</time>
		</>
	)}
</p>
